# Real file: deploy/ingress.yaml (untracked, see .git/info/exclude).
# Mirrors urs-backend's Ingress - the separate Traefik host forwards into
# this cluster's ingress-nginx, which then routes on Host header.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: <PREFIX>urs-web
  namespace: urs
spec:
  ingressClassName: nginx
  rules:
    - host: <URL> # urs.mcfx.ch / urs-stg.mcfx.ch
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: <PREFIX>urs-web
                port:
                  number: 80
